# Copy to .env (never committed) and fill in what you need. The server reads it in development
# (npm run dev -w server) and with npm start -w server; real environment variables win.

# Sign in with GitHub: create an OAuth App at https://github.com/settings/developers
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional in development (defaults shown). With NODE_ENV=production the server refuses to start
# until the first three are set, and lists what's missing
# DATABASE_URL=postgres://pairspace:pairspace@localhost:5433/pairspace
# WEB_ORIGIN=http://localhost:5173        (deployed: the site's https:// address)
# BETTER_AUTH_SECRET=                     (32+ characters: openssl rand -base64 32)
# WEB_DIR=                                (deployed: ../web/dist, the built web app to serve)
# PORT=8080

# Error reports (Sentry, sentry.io): unset, errors only go to the logs
# SENTRY_DSN=                             (the server's: its project's DSN)
# VITE_SENTRY_DSN=                        (the browser's, read when the web app is built)
