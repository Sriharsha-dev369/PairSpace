# Copy to .env (never committed) and fill in what you need. The server reads it in development
# (npm run dev -w server) and with npm start -w server; real environment variables win.

# Sign in with GitHub: create an OAuth App at https://github.com/settings/developers
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:5173/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional in development (defaults shown); required when deployed
# DATABASE_URL=postgres://pairspace:pairspace@localhost:5433/pairspace
# WEB_ORIGIN=http://localhost:5173
# BETTER_AUTH_SECRET=   (a long random string: openssl rand -base64 32)
