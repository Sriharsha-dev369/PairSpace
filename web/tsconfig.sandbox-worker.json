{
  // the sandbox's worker script: plain JS (see public/sandbox/frame.js), type-checked from its JSDoc
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sandbox-worker.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "WebWorker"],
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": ["public/sandbox/worker.js"]
}
