{
  "name": "pairspace-server",
  "version": "1.0.0",
  "description": "PairSpace WebSocket relay server",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm --target node24 --clean",
    "start": "node dist/index.js",
    "test:watch": "vitest"
  },
  "type": "module",
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
